{
  "name": "walkmate",
  "version": "0.2.0",
  "description": "A browser walkthrough and execution runtime exposed through MCP. Record demonstrations, let agents reproduce workflows, and review replayable evidence.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/preinpost/walkmate.git"
  },
  "homepage": "https://github.com/preinpost/walkmate#readme",
  "bugs": {
    "url": "https://github.com/preinpost/walkmate/issues"
  },
  "type": "module",
  "private": true,
  "keywords": [
    "mcp",
    "review",
    "voice",
    "walkthrough",
    "playbook",
    "rrweb"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "walkmate": "./dist/mcp/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/core/page','dist/core/page',{recursive:true})\"",
    "prepare": "npm run build",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "@rrweb/record": "^2.1.6",
    "marked": "^16.0.0",
    "rrweb": "^2.1.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
