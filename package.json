{
  "name": "pi-review-recorder",
  "version": "0.1.0",
  "description": "Pi extension: the agent opens a review page, you talk through it, and the voice + what you were looking at comes back as one timeline.",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@rrweb/record": "^2.1.6",
    "marked": "^16.0.0",
    "rrweb": "^2.1.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
