{
  "name": "walkmate",
  "version": "0.2.0",
  "description": "Record walkthroughs and voice feedback for coding agents, then turn demonstrations into reviewable playbooks. Agent-independent MCP server with an optional pi extension.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/preinpost/walkmate.git"
  },
  "homepage": "https://github.com/preinpost/walkmate#readme",
  "bugs": {
    "url": "https://github.com/preinpost/walkmate/issues"
  },
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package",
    "mcp",
    "review",
    "voice",
    "walkthrough",
    "playbook",
    "rrweb"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "walkmate": "./dist/mcp/cli.js",
    "review-recorder": "./dist/mcp/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/pi/index.ts"
    ]
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/core/page','dist/core/page',{recursive:true})\"",
    "prepare": "npm run build",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@rrweb/record": "^2.1.6",
    "marked": "^16.0.0",
    "rrweb": "^2.1.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
